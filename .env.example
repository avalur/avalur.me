# Public origin must exactly match the browser origin (including port locally).
SITE_URL=http://127.0.0.1:8827
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate a unique random value of at least 32 characters, never reuse the learning site's secret.
AUTH_SECRET=
# Comma-separated verified email addresses allowed to manage access.
# Administrators also need a separate trips grant to view trips.
ADMIN_EMAILS=

# Production email delivery; file transport is development-only.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=
# PRIVATE_MAIL_DIR=/absolute/ignored/path/.private/mail

# OAuth buttons are enabled only when both settings are present.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# All story JSON and media must stay in a PRIVATE Blob store.
PRIVATE_TRIPS_STORAGE=blob
PRIVATE_TRIPS_BLOB_ORIGIN=https://STORE.private.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=
# Local development alternative, always rejected on Vercel:
# PRIVATE_TRIPS_STORAGE=local
# PRIVATE_TRIPS_DIR=/absolute/ignored/path/.private/trips
