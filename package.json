    "@astrojs/vercel": "11.0.10",
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.0",
    "astro": "7.3.2",
    "react": "^19.2.4",
