---
import AccountLayout from '../layouts/AccountLayout.astro';
export const prerender = false;
---
<AccountLayout title="Новый пароль" lead="Выберите новый пароль. После сохранения вы войдёте в аккаунт, а прежние сеансы завершатся.">
  <form method="post" action="/api/account/reset-password" data-account-form data-clear-password class="account-form">
    <input type="hidden" name="token" data-email-token />
    <label>Пароль<input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="200" required /></label>
    <button class="primary" type="submit">Сохранить пароль</button>
    <p class="form-message" data-form-message role="status"></p>
  </form>
  <div class="account-links"><a href="/forgot-password/">Получить новую ссылку</a><a href="/login/">Ко входу</a></div>
</AccountLayout>
