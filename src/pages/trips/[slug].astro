---
import TripLayout from '../../layouts/TripLayout.astro';
import Icon from '../../components/trips/Icon.astro';
import Photo from '../../components/trips/Photo.astro';
import StoryVisual from '../../components/trips/StoryVisual.astro';
import Lightbox from '../../components/trips/Lightbox.astro';
import { getAccess } from '../../lib/access';
import { loadTrip } from '../../lib/trips/index';
import { photoCountLabel } from '../../lib/trips/labels';
import type { TripPhoto } from '../../lib/trips/types';

export const prerender = false;
const privateHeaders = { 'Cache-Control': 'private, no-store', 'X-Robots-Tag': 'noindex, nofollow, noarchive', 'Referrer-Policy': 'same-origin', 'Vary': 'Cookie' };
Object.entries(privateHeaders).forEach(([name, value]) => Astro.response.headers.set(name, value));
let access;
try { access = await getAccess(Astro.request); }
catch { return new Response('Раздел временно недоступен. Попробуйте позже.', { status: 503, headers: { ...privateHeaders, 'Content-Type': 'text/plain; charset=utf-8' } }); }
if (!access.user) return new Response(null, { status: 303, headers: { ...privateHeaders, Location: `/login/?next=${encodeURIComponent(Astro.url.pathname)}` } });
if (!access.canViewTrips) return new Response(null, { status: 303, headers: { ...privateHeaders, Location: '/account/' } });

let trip;
try { trip = await loadTrip(Astro.params.slug ?? ''); }
catch { return new Response('Раздел временно недоступен. Попробуйте позже.', { status: 503, headers: { ...privateHeaders, 'Content-Type': 'text/plain; charset=utf-8' } }); }
if (!trip) return new Response('Поход не найден.', { status: 404, headers: { ...privateHeaders, 'Content-Type': 'text/plain; charset=utf-8' } });
const { story, media, presentation: view } = trip;
const photos = media.photos;
const archive = [...media.archivePhotos].sort((left, right) => (left.year ?? 0) - (right.year ?? 0));
const lookup = new Map<string, TripPhoto>([...photos, ...archive].map(photo => [photo.id, photo]));
const hero = media.heroId === null ? undefined : lookup.get(media.heroId);
if (media.heroId !== null && !hero) return new Response('Раздел временно недоступен. Попробуйте позже.', { status: 503, headers: { ...privateHeaders, 'Content-Type': 'text/plain; charset=utf-8' } });
const hasRoute = story.route.length > 0;
const hasMedia = photos.length + archive.length + media.videos.length > 0;
const singleArchive = archive.length === 1;
const videoKindOrder = { video: 0, round: 1, live: 2 };
const videos = [...media.videos].sort((left, right) => videoKindOrder[left.kind] - videoKindOrder[right.kind]).map(clip => {
  const seconds = Math.round(Number(clip.duration));
  return { ...clip, displayKind: clip.kind, durationLabel: `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}` };
});
const first = videos[0];
const videoKinds = [
  { kind: 'video', label: 'Видео', count: videos.filter(clip => clip.displayKind === 'video').length },
  { kind: 'round', label: 'Кружочки', count: videos.filter(clip => clip.displayKind === 'round').length },
  { kind: 'live', label: 'Живые фото', count: videos.filter(clip => clip.displayKind === 'live').length },
].filter(kind => kind.count > 0);
const videoContextDefaults = { video: 'Видео из похода', round: 'Видеокружок', live: 'Несколько секунд вокруг снимка' };
const photoData = (photo: TripPhoto) => ({ id: photo.id, src: photo.src, alt: photo.alt, caption: photo.caption, year: photo.year, liveVideoId: photo.liveVideoId });
const pageData = JSON.stringify({ photos: photos.map(photoData), archivePhotos: archive.map(photoData), videos: videos.map(({ id, src, poster, title, durationLabel, displayKind }) => ({ id, src, poster, title, durationLabel, displayKind })) }).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
const visualPhotos = (chapterId: string) => (view.chapterVisuals.find(item => item.chapterId === chapterId)?.photoIds ?? []).map(id => lookup.get(id)).filter((photo): photo is TripPhoto => Boolean(photo));
const videoLookup = new Map(videos.map(clip => [clip.id, clip]));
const visualVideos = (chapterId: string) => (view.chapterVisuals.find(item => item.chapterId === chapterId)?.videoIds ?? []).map(id => videoLookup.get(id)).filter((clip): clip is typeof videos[number] => Boolean(clip));
---
<TripLayout title={`${story.title} · ${trip.year}`} year={trip.year} trip hasVideos={videos.length > 0} hasPhotos={photos.length > 0} hasArchivePhotos={archive.length > 0} hasRoute={hasRoute} textOnly={!hero}>
  {hero && <link slot="head" rel="preload" as="image" href={hero.src} />}
  <div class="wrap">
    <section class="hero" aria-labelledby="trip-title">
      <div class="hero-copy">
        <p class="hero-date">{view.dateLabel}{view.region && <> <span>·</span> {view.region}</>}</p>
        <h1 id="trip-title">{view.heroTitleLines.map((line, index) => <>{index > 0 && <br />}{line.emphasis ? <em>{line.text}</em> : line.text}</>)}</h1>
        <p class="hero-subtitle">{view.heroSubtitle}</p>
        <p class="hero-lead">{view.heroLead}</p>
        <div class="hero-actions"><a class="button" href="#story">Читать историю <Icon name="arrow-down" /></a>{photos.length > 0 ? <a class="text-link" href="#photos">Смотреть фотографии <Icon name="arrow-right" /></a> : archive.length > 0 && <a class="text-link" href="#memory">{singleArchive ? 'Смотреть архивный снимок' : 'Смотреть архивные фотографии'} <Icon name="arrow-right" /></a>}</div>
      </div>
      {hero && <figure class="hero-photo"><Photo photo={hero} eager /><figcaption class="hero-caption"><span>{view.heroCaption}</span><span>{view.heroCredit}</span></figcaption></figure>}
    </section>
    <div class="trip-strip" aria-label="О походе">{view.facts.map(fact => <span><Icon name={fact.icon} />{fact.label}</span>)}</div>

    <section class="section" id="story" aria-labelledby="story-heading">
      <div class="section-heading"><div><p class="eyebrow">Дневник похода</p><h2 id="story-heading">Как это было</h2></div><p class="aside-note">{view.narratorNoteLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p></div>
      <div class="story-grid">
        <aside class="story-rail"><nav class="chapter-nav" aria-label="Главы рассказа"><p class="chapter-nav-title">{view.chaptersLabel}</p>{story.chapters.map((chapter, index) => <a href={`#${chapter.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{chapter.title}</a>)}</nav></aside>
        <article class="story-text" aria-label="Рассказ о походе">
          <div class="story-intro">{story.intro.map(paragraph => <p>{paragraph}</p>)}</div>
          {story.chapters.map((chapter, index) => <section class="chapter" id={chapter.id} aria-labelledby={`heading-${chapter.id}`}><div class="chapter-top"><span class="chapter-number">{String(index + 1).padStart(2, '0')}</span><p class="eyebrow">{chapter.kicker}</p></div><h3 id={`heading-${chapter.id}`}>{chapter.title}</h3><div class="chapter-copy">{chapter.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div><StoryVisual photos={visualPhotos(chapter.id)} videos={visualVideos(chapter.id)} /></section>)}
        </article>
      </div>
    </section>
  </div>

  {first && <section class="video-band" id="video" aria-labelledby="video-heading">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">Со звуком и движением</p><h2 id="video-heading">Видео из поездки</h2></div><p class="aside-note">{view.videoNoteLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p></div>
      <div class="video-layout">
        <div><div class="video-stage"><video id="trip-video" controls playsinline tabindex="0" preload="metadata" poster={first.poster} src={first.src} aria-label={first.title}>Ваш браузер не поддерживает видео. <a href={first.src}>Открыть файл</a></video></div><div class="video-current"><h3 id="video-title">{first.title}</h3><span id="video-length">{first.durationLabel}</span></div></div>
        <div>
          <div class="video-tabs" role="group" aria-label="Тип видео">{videoKinds.map(kind => <button type="button" data-video-kind={kind.kind} aria-pressed={first.displayKind === kind.kind ? 'true' : 'false'}>{kind.label} · {kind.count}</button>)}</div>
          <div class="video-list" aria-label="Выбрать видео">{videos.map((clip, index) => <button type="button" class="video-choice" data-video={clip.id} data-clip-kind={clip.displayKind} aria-pressed={index === 0 ? 'true' : 'false'} hidden={clip.displayKind !== first.displayKind}><img src={clip.poster} alt="" width="57" height="57" loading="lazy" /><span>{clip.title}<small>{(clip.context && view.videoContextLabels[clip.context]) || videoContextDefaults[clip.displayKind]}</small></span><span class="video-duration">{clip.durationLabel}</span></button>)}</div>
          <p class="video-help">Выберите ролик и нажмите воспроизведение.</p>
        </div>
      </div>
    </div>
  </section>}

  <div class="wrap">
    {photos.length > 0 && <section class="section" id="photos" aria-labelledby="photos-heading">
      <div class="section-heading"><div><p class="eyebrow">{view.albumEyebrow}</p><h2 id="photos-heading">Фотоальбом</h2></div><p class="photo-count">{photoCountLabel(photos.length)} · {trip.year}</p></div>
      <div class:list={['gallery', { 'gallery-masonry': view.albumLayout === 'masonry' }]} id="gallery">{photos.map((photo, index) => <figure class:list={['gallery-card', { 'gallery-extra': index >= 12 }]} hidden={index >= 12}><Photo photo={photo} thumb /><figcaption>{photo.caption}</figcaption></figure>)}</div>
      {photos.length > 12 && <div class="gallery-actions"><button type="button" class="button button-outline" id="gallery-more" aria-expanded="false" aria-controls="gallery"><span>Все фотографии ({photos.length})</span><Icon name="arrow-down" /></button></div>}
      <p class="sr-only" id="gallery-status" aria-live="polite">Фотографии: показано {Math.min(12, photos.length)} из {photos.length}</p>
    </section>}
    <div class:list={['details-grid', { 'details-grid-single': !hasRoute }]}>
      <section id="people" aria-labelledby="people-heading"><p class="eyebrow">Наша компания</p><h2 id="people-heading">{view.peopleTitleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2><div class="people-grid">{story.participants.map(person => <div class="person"><span class="person-name">{person.displayName}</span><span class="person-role">{person.role}</span></div>)}</div>{view.peopleNote && <p class="route-note">{view.peopleNote}</p>}</section>
      {hasRoute && <section id="route" aria-labelledby="route-heading"><p class="eyebrow">{view.routeEyebrow}</p><h2 id="route-heading">{view.routeTitle}</h2><p class="route-note">{view.routeNote}</p><ol class="route-stops">{story.route.map(stop => <li>{stop.label}<small>{stop.note}</small></li>)}</ol></section>}
    </div>
    {archive.length > 0 && <section class:list={['memory-section', { 'memory-section-single': singleArchive }]} id="memory" aria-labelledby="memory-heading"><div><p class="eyebrow">{view.memoryEyebrow ?? 'Листая старые фотографии'}</p><h2 id="memory-heading">{view.memoryTitleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2><p>{view.memoryText}</p></div><div class="memory-photos">{archive.map(photo => <figure><Photo photo={photo} thumb={!singleArchive} /><figcaption><span class="memory-year">{photo.year}</span><span>{singleArchive ? photo.caption : 'Из нашего архива'}</span></figcaption></figure>)}</div></section>}
    <section class="closing" aria-label="Вместо послесловия"><p class="eyebrow">До следующей встречи</p><blockquote>«{story.closingQuote}»</blockquote><p>{view.closingCredit}</p></section>
  </div>
  <Fragment slot="after-main">{hasMedia && <><Lightbox /><script is:inline type="application/json" id="page-data" set:html={pageData} /></>}</Fragment>
</TripLayout>
<script>import '../../scripts/trips.js';</script>
