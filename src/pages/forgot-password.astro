---
import AccountLayout from '../layouts/AccountLayout.astro';
export const prerender = false;
---
<AccountLayout title="Восстановить доступ" lead="Укажите почту аккаунта. Мы пришлём ссылку для установки нового пароля.">
  <form method="post" action="/api/account/forgot-password" data-account-form class="account-form">
    <label>Электронная почта<input type="email" name="email" autocomplete="email" required maxlength="254" /></label>
    <button class="primary" type="submit">Отправить ссылку</button>
    <p class="form-message" data-form-message role="status"></p>
  </form>
  <div class="account-links"><a href="/login/">Вернуться ко входу</a></div>
</AccountLayout>
