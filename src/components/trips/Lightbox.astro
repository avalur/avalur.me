---
import Icon from './Icon.astro';
---
<dialog class="lightbox" id="lightbox" aria-label="Просмотр фотографии">
  <div class="lightbox-inner">
    <div class="lightbox-toolbar"><span class="lightbox-counter" id="lightbox-counter" aria-live="polite"></span><button type="button" class="icon-button" id="lightbox-close" aria-label="Закрыть фотографию"><Icon name="close" /></button></div>
    <div class="lightbox-canvas"><button type="button" class="icon-button lightbox-step lightbox-prev" id="lightbox-prev" aria-label="Предыдущая фотография"><Icon name="arrow-left" /></button><img class="lightbox-image" id="lightbox-image" alt="" /><video class="lightbox-motion" id="lightbox-motion" playsinline controls preload="none" hidden aria-label="Живое фото"></video><button type="button" class="icon-button lightbox-step lightbox-next" id="lightbox-next" aria-label="Следующая фотография"><Icon name="arrow-right" /></button></div>
    <div class="lightbox-bottom"><p class="lightbox-caption" id="lightbox-caption"></p><div class="lightbox-links"><button type="button" class="lightbox-motion-toggle" id="lightbox-motion-toggle" aria-pressed="false" aria-controls="lightbox-motion" hidden>Оживить снимок</button><a class="lightbox-original" id="lightbox-original" target="_blank" rel="noopener noreferrer">Открыть снимок <Icon name="arrow-up-right" /></a></div></div>
  </div>
</dialog>
